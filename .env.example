# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. Anahtar üretmek için: npm run secrets
# Tüm anahtar ve şifreler birbirinden FARKLI olmalı; zayıf değerlerde sunucu başlamaz.
DATABASE_URL="file:./dev.db"

# iron-session çerez şifreleme anahtarı (en az 32 karakter)
SESSION_SECRET=""
# AES-256-GCM e-posta şifreleme anahtarı (32 bayt, hex = 64 karakter)
EMAIL_ENCRYPTION_KEY=""
# E-posta özetleri ve OTP özetleri için HMAC anahtarı
EMAIL_HASH_PEPPER=""
# Kimlik ↔ profil köprüsü için HMAC anahtarı
PROFILE_LINK_SECRET=""

# Yönetim paneli (en az 12 karakter) ve saha check-in (en az 10 karakter) şifreleri
ADMIN_PASSWORD=""
CHECKIN_PASSWORD=""

# E-postalardaki bağlantılar için sitenin adresi (üretimde https:// zorunlu, localhost olamaz)
SITE_URL="http://localhost:3000"

# console = OTP kodunu terminale yazar (YALNIZCA geliştirme) | smtp = gerçek gönderim (üretimde zorunlu)
# SMTP_USER ve SMTP_PASS birlikte girilmeli; üretimde SMTP_HOST/USER/PASS ve gerçek MAIL_FROM zorunlu.
MAIL_MODE="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Beytepe Geyiği <noreply@example.com>"
